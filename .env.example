# =============================================================================
# ChaosPilot environment template
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in your own values:
#
#   cp .env.example .env          # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# Never commit .env. Never put real keys in this template.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
CHAOSPILOT_ENV=development
CHAOSPILOT_HOST=127.0.0.1
CHAOSPILOT_PORT=8090
CHAOSPILOT_DB_PATH=./data/chaos.db
CHAOSPILOT_MODEL_DIR=./models
CHAOSPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 3 experiment timeline and fault parameters
CHAOSPILOT_BASELINE_SECONDS=10
CHAOSPILOT_FAULT_SECONDS=20
CHAOSPILOT_RECOVERY_SECONDS=10
CHAOSPILOT_LATENCY_MS=2000
CHAOSPILOT_MEMORY_MB=256
CHAOSPILOT_COLLECTOR_INTERVAL=1
SAMPLE_STACK_HOST=127.0.0.1

# Legacy core scaffold (not the served API)
CHAOSPILOT_COLLECTOR_ENABLED=true
CHAOSPILOT_COLLECTOR_INTERVAL_SECONDS=5
CHAOSPILOT_SIMULATION_MODE=true
CHAOSPILOT_HISTORY_MINUTES=60

# -----------------------------------------------------------------------------
# Chaos engine (Docker SDK for Python)
# -----------------------------------------------------------------------------
CHAOSPILOT_DOCKER_ENABLED=false
CHAOSPILOT_DOCKER_NETWORK=chaospilot
CHAOSPILOT_COMPOSE_PROJECT=chaospilot

# -----------------------------------------------------------------------------
# LLM provider -- calls happen only in the backend.
# Choose "ollama" (local, no key) or "openai" (hosted, key required).
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Hosted OpenAI-compatible endpoint (leave the key empty to disable).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# Optional alternative providers (placeholders only).
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------------------------
# Frontend (Vite) -- ONLY non-secret values. VITE_* is embedded in the bundle.
# API keys must never appear here.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8090
VITE_WS_BASE_URL=ws://localhost:8090

# -----------------------------------------------------------------------------
# Sample stack
# -----------------------------------------------------------------------------
# false = fragile by default (no retries, 5s timeout, no circuit breaker)
# true  = 1 retry, 1s timeout, circuit breaker + fallback responses
RESILIENT=false

# Host ports (gateway is the public entry point; 8001-8005 let the collector
# reach each service directly).
GATEWAY_PORT=8000
AUTH_PORT=8001
ORDERS_PORT=8002
CACHE_PORT=8003
PAYMENTS_PORT=8004
DB_PORT=8005

SAMPLE_STACK_LOG_LEVEL=info
COMPOSE_PROJECT_NAME=chaospilot
