# Frontend (local, non-secret)

# Leave both blank to use the Vite dev proxy, which forwards /topology,
# /experiments and /ws to the backend on 127.0.0.1:8090.
# Point them at another host only when the backend runs elsewhere.
VITE_API_BASE_URL=
VITE_WS_URL=

# Set to 1 to force the scripted demo feed. The same is available per URL
# with ?mock=1, or with ?ws=ws://host:port/ws for a one-off endpoint.
VITE_MOCK=0
